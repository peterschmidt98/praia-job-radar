# Copy to .env for local runs. Never commit .env.
# The same names go into GitHub → Settings → Secrets and variables → Actions.

# Anthropic (Judge)
ANTHROPIC_API_KEY=

# Apify (LinkedIn) — leave empty until LinkedIn is calibrated (docs/SETUP.md step 7)
APIFY_TOKEN=

# Adzuna (free developer key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Supabase (EU project) — the service-role key is for the pipeline ONLY, never the web app
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nudge email (dedicated Gmail account + app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# During development: Peter's address ONLY. Add Gabi's at go-live.
NUDGE_TO=

# Error alerts go here
ALERT_TO=

# --- Web app (public values; set in Cloudflare Pages and web/.env) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
